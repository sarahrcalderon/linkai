{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Linkai — 1 PostgreSQL (diagnóstico)",
      "type": "shell",
      "command": "Get-Service *postgres* | Select-Object Name,Status",
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "clear": false }
    },
    {
      "label": "Linkai — 2 Backend",
      "type": "shell",
      "command": "if (!(Test-Path .env)) { throw 'Configure backend/.env de desenvolvimento antes de iniciar.' }; & .venv/Scripts/python.exe -m uvicorn aplicacao.principal:app --host localhost --port 8000 --reload --no-proxy-headers",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "clear": false }
    },
    {
      "label": "Linkai — 3 Frontend",
      "type": "shell",
      "command": "npm.cmd run dev -- --host localhost --port 5173 --strictPort",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "clear": false }
    },
    {
      "label": "Linkai — 4 Diagnóstico",
      "type": "shell",
      "command": "powershell.exe",
      "args": ["-NoLogo", "-NoProfile", "-NoExit"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "clear": false }
    }
  ]
}
