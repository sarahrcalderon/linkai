AMBIENTE=desenvolvimento
# Worker: desativado por padrão; mailpit somente em desenvolvimento, brevo em produção.
EMAIL_PROVEDOR=desativado
SMTP_HOST=127.0.0.1
SMTP_PORTA=1025
SMTP_REMETENTE=nao-responda@linkai.test
SMTP_TIMEOUT_SEGUNDOS=5
# Prazo do registro best effort de acessos; entre 0.01 e 5 segundos, sem retries.
ANALYTICS_PRAZO_SEGUNDOS=0.5
ORIGENS_PERMITIDAS=["http://localhost:5173"]

# Substitua os placeholders apenas no .env local, nunca versionado.
URL_BANCO=postgresql+asyncpg://usuario:senha@localhost:5432/linkai
# Neon: postgresql://usuario:senha@host/banco?sslmode=require

# Limite compartilhado no PostgreSQL por IP/rota; memória é barreira adicional.
# Inclui tentativas com dados inválidos.
CADASTRO_LIMITE_TENTATIVAS=5
CADASTRO_JANELA_SEGUNDOS=900

LOGIN_LIMITE_TENTATIVAS=10
LOGIN_JANELA_SEGUNDOS=900
SESSAO_DURACAO_SEGUNDOS=28800
SESSAO_COOKIE_SAMESITE=lax
# Desenvolvimento HTTP: opcionalmente false. Produção força Secure (HTTPS).
# SESSAO_COOKIE_SEGURO=true
# Produção também exige AMBIENTE=producao e ORIGENS_PERMITIDAS com HTTPS.
# Para sites distintos, use SESSAO_COOKIE_SAMESITE=none com Secure=true.

# Desde a Etapa 4.3, necessário nos fluxos públicos e no limitador persistente.
# Configure um segredo aleatório de pelo menos 32 bytes apenas no ambiente local.
# VERIFICACAO_SEGREDO=
VERIFICACAO_VALIDADE_SEGUNDOS=600
VERIFICACAO_LIMITE_TENTATIVAS=5
VERIFICACAO_INTERVALO_REENVIO=60
VERIFICACAO_LIMITE_ENVIOS=5
VERIFICACAO_JANELA_ENVIOS=3600

# Etapa 4.2: somente ao ativar explicitamente a factory de envio.
# BREVO_API_KEY=CHAVE_CONFIGURADA_APENAS_LOCALMENTE
# BREVO_EMAIL_REMETENTE=remetente@example.com
BREVO_NOME_REMETENTE=Linkai
BREVO_TIMEOUT_SEGUNDOS=10
BREVO_LIMITE_TENTATIVAS=3
BREVO_TEMPO_TOTAL_SEGUNDOS=20

# Etapa 4.3: chaves estáveis e independentes, compartilhadas entre API e worker.
# Gere OUTBOX_CHAVE com Fernet.generate_key(); não regenere ao reiniciar.
# OUTBOX_CHAVE=CONFIGURE_UMA_CHAVE_FERNET_NO_AMBIENTE
OUTBOX_LEASE_SEGUNDOS=120
OUTBOX_LIMITE_TENTATIVAS=5
OUTBOX_INTERVALO_WORKER=1
VERIFICACAO_LIMITE_REQUISICOES=20
